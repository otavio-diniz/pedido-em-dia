# Canonical line endings for reproducible checkout across operating systems
* text=auto

# Prettier/ESLint, source, configs and reproducible documentation use LF
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.cjs text eol=lf
*.mjs text eol=lf
*.css text eol=lf
*.json text eol=lf
*.md text eol=lf
*.html text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.txt text eol=lf
bun.lock text eol=lf
.prettierrc text eol=lf
.prettierignore text eol=lf
.gitignore text eol=lf

# Keep media bytes unchanged
*.png binary
*.jpg binary
*.jpeg binary
*.svg text eol=lf
*.ico binary
